{
  lib,
  callPackage,
  symlinkJoin,
}:

# Builds a set of PowerShell Gallery modules from a lock file generated by
# ./update.py. The root module and everything it depends on end up in a single
# `share/powershell/Modules` tree.

{
  pname,
  # Lock file generated by `./update.py <root>`.
  lockFile,
  # Name of the root module inside the lock file; determines the version.
  root,
  # Which modules to install. Their dependencies are added automatically.
  modules ? [ root ],
  # Extra arguments for the build of a single module, keyed by module name.
  moduleArgs ? { },
  meta ? { },
}:

let

  lock = lib.importJSON lockFile;

  buildGalleryModule = callPackage ./build-gallery-module.nix { };

  entryOf = name: lock.${name} or (throw "${pname}: unknown module '${name}' (not in the lock file)");

  allModules = lib.mapAttrs (
    name: entry:
    buildGalleryModule (
      {
        pname = name;
        inherit (entry) version hash;
        meta = {
          description = "PowerShell module ${name}";
        }
        // removeAttrs meta [
          "description"
          "longDescription"
          "mainProgram"
        ];
      }
      // (moduleArgs.${name} or { })
    )
  ) lock;

  # The selected modules plus everything they depend on.
  selected = map (module: module.key) (
    builtins.genericClosure {
      startSet = map (name: { key = name; }) modules;
      operator = { key }: map (dep: { key = dep; }) (builtins.attrNames (entryOf key).dependencies);
    }
  );

in

symlinkJoin {
  name = "${pname}-${lock.${root}.version}";
  inherit (lock.${root}) version;

  paths = map (name: allModules.${name}) selected;

  passthru = {
    inherit lock selected;
    modules = allModules;
  };

  meta = {
    platforms = lib.platforms.all;
  }
  // meta;
}
